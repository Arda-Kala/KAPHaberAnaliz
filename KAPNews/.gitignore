*.coveragexml

# Yayınlama / yayın çıktıları
publish/
*.pubxml
*.pubxml.user

# Kullanıcıya özel gizli anahtarlar (User Secrets diskte proje dışında,
# ~/.microsoft/usersecrets altında tutulur; yine de olası yanlışlıkla
# oluşabilecek yerel dosyalar için önlem)
secrets.json
*.env
.env
.env.*

# appsettings.*.json ortam-özel override dosyaları (varsayılan appsettings.json
# ve appsettings.Development.json commit edilir; kişisel/prod override'lar edilmez)
appsettings.Local.json
appsettings.Production.json

# Veritabanı dosyaları (varsa yerel SQLite/SQL Server LocalDB)
*.mdf
*.ldf
*.db
*.sqlite

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Serilog dosya sink çıktıları (kap-haberleri-analiz-*.log)
logs/
**/logs/
*.log

# macOS / Windows sistem dosyaları
.DS_Store
Thumbs.db

# Node (varsa dashboard için)
node_modules/
